---
import { render } from 'astro:content';
import Base from '../layouts/Base.astro';
import AssessmentList from '../components/AssessmentList.astro';
import { VISIBLE_YEARS, yearNote, overviews, assessments } from '../lib/site';

export function getStaticPaths() {
  return VISIBLE_YEARS.map((y) => ({ params: { year: `year-${y}` }, props: { y } }));
}

const { y } = Astro.props;
const overview = (await overviews()).find((o) => o.data.year === y);
const yearAssessments = (await assessments()).filter((a) => a.data.year === y);
const { Content } = overview ? await render(overview) : { Content: null };
const o = overview?.data;

// One list of what ākonga do this year. A unit whose name matches an assessment's title links
// to that assessment's page; any assessment no unit names is added at the end.
const same = (a: string, b: string) => a.trim().toLowerCase() === b.trim().toLowerCase();
const items = [
  ...(o?.units ?? []).map((u) => ({
    name: u.name,
    graded: u.graded,
    summary: u.summary,
    task: yearAssessments.find((a) => same(a.data.title, u.name)),
  })),
  ...yearAssessments
    .filter((a) => !(o?.units ?? []).some((u) => same(u.name, a.data.title)))
    .map((a) => ({ name: a.data.title, graded: true, summary: a.data.summary, task: a })),
];
---

<Base title={`Year ${y}`} description={o?.summary}>
  <p class="crumbs"><a href="/">Home</a> › Year {y}</p>
  <h1>Year {y} Digital Technologies</h1>
  {o?.draft && <p class="draft-banner">Draft: this overview isn't on the live site yet.</p>}

  {
    o ? (
      <>
        <p class="lead">{o.summary}</p>

        <h2>What you'll do</h2>
        {items.length > 0 ? (
          <ul class="cards" data-pagefind-ignore>
            {items.map((it) => (
              <li>
                <div class="row">
                  {it.task ? (
                    <a class="title" href={`/assessments/${it.task.id}/`}>{it.name}</a>
                  ) : (
                    <span class="title">{it.name}</span>
                  )}
                  <span class={it.graded ? 'tag graded' : 'tag'}>{it.graded ? 'Graded' : 'Not graded'}</span>
                  {it.task?.data.draft && <span class="tag draft">Draft</span>}
                </div>
                <p>{it.summary}</p>
              </li>
            ))}
          </ul>
        ) : (
          <p class="empty">Details are on the way.</p>
        )}

        {o.canDo.length > 0 && (
          <>
            <h2>By the end, you can</h2>
            <ul class="ticks">
              {o.canDo.map((c) => (
                <li>{c}</li>
              ))}
            </ul>
          </>
        )}

        {o.tools.length > 0 && (
          <>
            <h2>Tools you'll use</h2>
            <p>{o.tools.join(' · ')}</p>
          </>
        )}

        {Content && <Content />}
      </>
    ) : (
      <>
        <p class="lead">{yearNote(y)}. The overview for this year is on the way.</p>
        {yearAssessments.length > 0 && (
          <>
            <h2>What you'll do</h2>
            <AssessmentList items={yearAssessments} />
          </>
        )}
      </>
    )
  }

  <p class="guides-link">Stuck on a tool? See all <a href="/guides/">How-to guides</a>.</p>
</Base>
