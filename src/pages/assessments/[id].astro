---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import GuideList from '../../components/GuideList.astro';
import LearnList from '../../components/LearnList.astro';
import { assessments, guides, learnPages, yearSlug } from '../../lib/site';

export async function getStaticPaths() {
  return (await assessments()).map((a) => ({ params: { id: a.id }, props: { a } }));
}

const { a } = Astro.props;
const d = a.data;
const { Content, headings } = await render(a);
const allGuides = await guides();
const needed = d.guides.map((id) => allGuides.find((g) => g.id === id)).filter((g) => g !== undefined);
const allLearn = await learnPages();
const reminders = d.learn.map((id) => allLearn.find((l) => l.id === id)).filter((l) => l !== undefined);
const hasHelp = (a.body ?? '').trim().length > 0;

// "Jump to" links: the page's own sections, in order, with short names.
// The first section is the plan; "Help with your template" is the template help; reminders and guides come last.
const sections = headings.filter((h) => h.depth === 2);
const jumps = [
  ...sections.map((h, i) => ({
    slug: h.slug,
    label: /^help with/i.test(h.text) ? 'Template help' : /^example/i.test(h.text) ? 'Example' : i === 0 ? 'Plan' : h.text,
  })),
  ...(reminders.length ? [{ slug: 'reminders', label: 'Reminders' }] : []),
  ...(needed.length ? [{ slug: 'guides', label: 'Guides' }] : []),
];
---

<Base title={d.title} description={d.summary}>
  <p class="crumbs"><a href="/">Home</a> › <a href={yearSlug(d.year)}>Year {d.year}</a> › Assessment</p>
  <h1>{d.title}</h1>
  {d.draft && <p class="draft-banner">Draft: this assessment isn't on the live site yet.</p>}
  <p class="lead">{d.summary}</p>

  <dl class="facts">
    <dt>Year</dt><dd>{d.year}</dd>
    {d.standards.length > 0 && (<><dt>Standard</dt><dd>{d.standards.map((s) => `AS${s}`).join(', ')}</dd></>)}
    {d.term && (<><dt>Term</dt><dd>{d.term}</dd></>)}
    {d.due && (<><dt>Due</dt><dd>{d.due}</dd></>)}
    <dt>Hand in</dt><dd>{d.handIn}</dd>
  </dl>

  {
    (d.template || d.links.length > 0 || d.files.length > 0 || d.slides) && (
      <>
        <h2>Your files</h2>
        <div class="btn-row">
          {d.links.map((l) => (
            <a class="btn primary" href={l.url} target="_blank" rel="noopener">
              {l.label}
            </a>
          ))}
          {d.template && (
            <a class="btn primary" href={d.template} target="_blank" rel="noopener">
              Make a copy of your template
            </a>
          )}
          {d.files.map((f) => (
            <a class="btn" href={encodeURI(f.path)} target="_blank" rel="noopener">
              {f.label} (PDF)
            </a>
          ))}
          {d.slides && (
            <a class="btn" href={encodeURI(d.slides)} target="_blank" rel="noopener">
              Evidence guide slides (PDF)
            </a>
          )}
        </div>
      </>
    )
  }

  {
    jumps.length > 1 && (
      <p class="jump" data-pagefind-ignore>
        Jump to:{' '}
        {jumps.map((j, i) => (
          <>
            {i > 0 && ' · '}
            <a href={`#${j.slug}`}>{j.label}</a>
          </>
        ))}
      </p>
    )
  }

  {
    hasHelp && (
      <div class="help">
        <Content />
      </div>
    )
  }

  {
    reminders.length > 0 && (
      <details class="guides-fold">
        <summary>
          <h2 id="reminders">Need a reminder?</h2>
          <span class="count">{reminders.length} Learn pages</span>
        </summary>
        <LearnList items={reminders} />
      </details>
    )
  }

  {
    needed.length > 0 && (
      <details class="guides-fold">
        <summary>
          <h2 id="guides">Guides you'll need</h2>
          <span class="count">{needed.length} guides</span>
        </summary>
        <GuideList items={needed} />
      </details>
    )
  }
</Base>
