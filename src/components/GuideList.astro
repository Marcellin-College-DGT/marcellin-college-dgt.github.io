---
import type { CollectionEntry } from 'astro:content';

interface Props {
  items: CollectionEntry<'guides'>[];
  empty?: string;
}
const { items, empty = 'Guides are on the way.' } = Astro.props;
---

{
  items.length ? (
    <ul class="cards" data-pagefind-ignore>
      {items.map((g) => (
        <li>
          <div class="row">
            <a class="title" href={`/guides/${g.id}/`}>{g.data.title}</a>
            {g.data.draft && <span class="tag draft">Draft</span>}
          </div>
          <p>Use this when {g.data.useWhen}</p>
        </li>
      ))}
    </ul>
  ) : (
    <p class="empty">{empty}</p>
  )
}
